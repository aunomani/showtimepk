# Only needed if you run `npm run scrape` on your own computer.
# On GitHub, add this as a repository secret instead (Settings → Secrets and variables → Actions).
# Never put real keys in a file that gets committed.
#
# TMDB "API Read Access Token" (the long one starting with eyJ...), from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
# ...or the short v3 "API Key" instead
TMDB_API_KEY=
